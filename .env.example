# -----------------------------------------------------------------------------
# n8n-hubspot-gdpr-ccpa-consent-preference-sync: environment template
#
# Copy to .env (never commit it). Values shaped like your_something_here are
# placeholders and are treated exactly like blank values: the fail-safe
# default applies until you replace them locally.
#
#   Standalone engine:  node --env-file=.env src/index.js --serve
#   n8n:                set these as n8n environment variables; HubSpot access
#                       comes from the n8n HubSpot credential, not from here.
# -----------------------------------------------------------------------------

# --- Safety gates ------------------------------------------------------------
# Only the literal string "false" turns these off.
# DRY_RUN: build and return the compliance plan, write nothing.
DRY_RUN=true
# SANDBOX_MODE: act only on a verified HubSpot SANDBOX / DEVELOPER_TEST portal.
SANDBOX_MODE=true
# Required for SANDBOX_MODE=false (production contacts).
ALLOW_PRODUCTION_MODE=false

# --- HubSpot -------------------------------------------------------------------
# Private app access token (standalone engine only). Scopes: crm.objects.contacts.read,
# crm.objects.contacts.write, communication_preferences.statuses.batch.write,
# communication_preferences.write (or read_write), tickets (only if review tickets are on).
HUBSPOT_PRIVATE_APP_TOKEN=your_hubspot_private_app_token_here
HUBSPOT_BASE_URL=https://api.hubapi.com
# Optional: pin sandbox mode to one numeric portal ID.
HUBSPOT_SANDBOX_PORTAL_ID=your_hubspot_sandbox_portal_id_here
# Ticket pipeline and stage for privacy review tickets (leave as placeholders to disable).
TARGET_PIPELINE_ID=your_hubspot_ticket_pipeline_id_here
TARGET_PIPELINE_STAGE_ID=your_hubspot_ticket_stage_id_here
# Create a HubSpot contact when the consent subject is unknown (data minimization: off).
CREATE_MISSING_CONTACTS=false

# --- Webhook security ------------------------------------------------------------
# Shared HMAC secret between your consent relay and this workflow.
WEBHOOK_SIGNING_SECRET=your_webhook_signing_secret_here
REQUIRE_SIGNATURE=true
# Replay window in seconds (30-900).
SIGNATURE_TOLERANCE_SECONDS=300

# --- Consent mapping -------------------------------------------------------------
# Standalone engine: path to your mapping file (see config/consent-mapping.example.json).
CONSENT_MAPPING_FILE=your_consent_mapping_file_path_here
# n8n: the same mapping as single-line JSON.
CONSENT_MAPPING_JSON=your_consent_mapping_json_here

# --- Audit log -------------------------------------------------------------------
# Optional HTTPS endpoint that receives each audit entry (pseudonymous, no raw email).
AUDIT_LOG_WEBHOOK_URL=your_audit_log_webhook_url_here

# --- Standalone runtime ------------------------------------------------------------
HOST=127.0.0.1
PORT=8791
